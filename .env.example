# MongoDB connection URI (local MongoDB community edition or Atlas)
MONGODB_URI=mongodb://localhost:27017/neetpg

# Cloudinary connection URL (only needed in production; local uses local filesystem fallback)
CLOUDINARY_URL=

# Port configuration
PORT=5000

# Google OAuth 2.0 Client ID (Required for Google Sign-In)
GOOGLE_CLIENT_ID=

# Allowed Emails Whitelist (Comma-separated list of emails authorized to log in)
# E.g. ALLOWED_EMAILS=yourname@gmail.com,anotheruser@gmail.com
ALLOWED_EMAILS=
